{
  "schema_version": 1,
  "id": "capabilities_v1",
  "inference_enabled": false,
  "baseline": {
    "language": "cpp",
    "compiler_image": "cpp",
    "optimization": "-O2",
    "standard": "c++20",
    "architecture": "x86_64"
  },
  "families": [
    {
      "id": "record_codec",
      "behavior": "Decode a tagged little-endian record, mix its count and value with a fixed salt, then add the fifth input byte when present to the decoder result (including an error result).",
      "root": "family_root",
      "chain": [
        "family_root",
        "decode_item"
      ],
      "roles": {
        "record_check": "codec_decision",
        "value_mix": "codec_update"
      },
      "role_descriptions": {
        "record_check": "Both short-input and tag-rejection conditional branches. Their compare instructions are optional context; initializing an error return is not a check.",
        "value_mix": "Both the count-times-value multiplication and XOR with the fixed salt. The intervening salt load is optional context."
      }
    },
    {
      "id": "dispatch_registry",
      "behavior": "For nonempty input choose one of two byte aggregation policies from the low bit of the first byte, call that policy and add the choice bit to its result; return zero for empty input.",
      "root": "family_root",
      "chain": [
        "family_root",
        "add_policy",
        "xor_policy"
      ],
      "roles": {
        "empty_check": "dispatch_decision",
        "policy_call": "dispatch_call"
      },
      "role_descriptions": {
        "empty_check": "The conditional branch rejecting empty input; its length test is optional context.",
        "policy_call": "The actual indirect call to the selected policy. Its table load and choice-bit preparation are optional context."
      }
    },
    {
      "id": "numeric_aggregation",
      "behavior": "Decode bounded signed little-endian values, sort them, form a rank-weighted wrapping sum, then XOR that aggregate with a fixed constant and return the zero-extended result.",
      "root": "family_root",
      "chain": [
        "family_root",
        "aggregate_values"
      ],
      "roles": {
        "ordering": "numeric_order"
      },
      "role_descriptions": {
        "ordering": "All three signed value-comparison branches of the small-range insertion ordering. Their compare instructions are optional context; count checks, the bounded no-op introsort call, and the weighted sum do not implement these decisions."
      }
    },
    {
      "id": "variable_objects",
      "behavior": "Check a length-prefixed byte object, reduce its payload using an order-sensitive checksum, then add a fixed adjustment to the inspector result, including its error results.",
      "root": "family_root",
      "chain": [
        "family_root",
        "inspect_payload"
      ],
      "roles": {
        "header_check": "object_decision",
        "payload_loop": "object_payload"
      },
      "role_descriptions": {
        "header_check": "Both conditional branches rejecting a short header or a declared length beyond available payload. Their compares, length load and length adjustment are optional context; error-return initialization is not a check.",
        "payload_loop": "The shift and two additions computing checksum times 33 plus the payload byte. Operand preparation, byte load and pointer increment in that iteration are optional context; the loop-bound comparison is not the checksum update."
      }
    },
    {
      "id": "callback_policy",
      "behavior": "Select the fixed index-dependent byte transform, pass it to an indirect callback iterator over the input, then add a fixed adjustment to the aggregate result.",
      "root": "family_root",
      "chain": [
        "family_root",
        "apply_callback",
        "transform_item"
      ],
      "roles": {
        "callback_invoke": "callback_call"
      },
      "role_descriptions": {
        "callback_invoke": "The actual indirect callback call. Loading its byte/index arguments and advancing the iteration index are optional context."
      }
    },
    {
      "id": "session_state",
      "behavior": "Create a fresh zeroed count/checksum session on each invocation, feed every input byte through its state updater and return the XOR of the individual step results.",
      "root": "family_root",
      "chain": [
        "family_root",
        "update_session"
      ],
      "roles": {
        "state_update": "session_update"
      },
      "role_descriptions": {
        "state_update": "The count increment and store, and checksum shift, two additions and store. The state loads, byte extension, checksum copy and final return XOR are optional context."
      }
    }
  ],
